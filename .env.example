PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# Optional fixed activation passwords
BOSS_1D_PASSWORD=PUT_YOUR_1_DAY_PASSWORD_HERE
BOSS_6M_PASSWORD=PUT_YOUR_6_MONTH_PASSWORD_HERE
BOSS_UNLIMITED_PASSWORD=PUT_YOUR_UNLIMITED_PASSWORD_HERE

# Telegram bot (optional but required for Telegram Admin Panel)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
ADMIN_TELEGRAM_ID=YOUR_TELEGRAM_USER_ID
